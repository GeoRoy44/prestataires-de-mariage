---
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'blog'>; headingLevel?: 2 | 3; }
const {article,headingLevel=3}=Astro.props;
const Heading=headingLevel===2?'h2':'h3';
const categoryLabels:Record<string,string>={'photographie-video':'Photographie & vidéo','reception-restauration':'Réception & restauration','ambiance-decoration':'Ambiance & décoration','organisation-accompagnement':'Organisation & accompagnement'};
---
<article class="card"><p class="card__meta">{categoryLabels[article.data.category]}</p><Heading class="card-title"><a href={`/blog/${article.id}/`}>{article.data.title}</a></Heading><p>{article.data.description}</p><a href={`/blog/${article.id}/`}>Le guide en détail <span aria-hidden="true">→</span></a></article>
<style>.card-title{font-size:1.8rem;line-height:1.14;margin:0 0 10px}</style>
