---
interface Props { text: string; }
const {text}=Astro.props;
const tokens:Array<{text:string;href?:string}>=[];
const pattern=/\[([^\]]+)\]\((https?:\/\/[^\s)]+|\/[^\s)]+)\)/g;
let cursor=0;
for(const match of text.matchAll(pattern)){
  const index=match.index??0;
  if(index>cursor)tokens.push({text:text.slice(cursor,index)});
  tokens.push({text:match[1],href:match[2]});
  cursor=index+match[0].length;
}
if(cursor<text.length)tokens.push({text:text.slice(cursor)});
---
{tokens.map(token=>token.href?<a href={token.href}>{token.text}</a>:token.text)}
