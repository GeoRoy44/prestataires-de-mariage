---
import { pickPhoto, photoPageUrl, photoImageUrl } from '../data/stockPhotos';
interface Props { articleId: string; category: string; }
const { articleId, category } = Astro.props;
const photo = pickPhoto(articleId, category);
---
<figure class="comparison-visual"><div class="comparison-visual-frame"><img src={photoImageUrl(photo.id)} alt={photo.alt} width="960" height="600" loading="eager" decoding="async" referrerpolicy="strict-origin-when-cross-origin" /></div><figcaption>Photo : <a href={photoPageUrl(photo.id)} target="_blank" rel="noopener noreferrer">{photo.author} / Unsplash<span class="sr-only"> (nouvel onglet)</span></a>.<span>Image d’illustration, sans lien avec les prestataires cités.</span></figcaption></figure>
<style>
.comparison-visual{width:100%;max-width:560px;margin:0 0 30px}.comparison-visual-frame{aspect-ratio:8/5;overflow:hidden;border:1px solid #d9cfc2;border-radius:4px;background:#E8DED0}.comparison-visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.comparison-visual figcaption{margin-top:9px;font-size:.75rem;line-height:1.6;color:#493D35}.comparison-visual figcaption a{color:#493D35;text-decoration:underline;text-underline-offset:3px}.comparison-visual figcaption span:not(.sr-only){display:block}.comparison-visual .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}@media(max-width:600px){.comparison-visual{max-width:100%;margin-bottom:24px}}
</style>
