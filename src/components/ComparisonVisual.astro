---
interface Props { articleId: string; }
const {articleId}=Astro.props;
const photos=[
{id:'f_OHqCqfLR4',author:'Sabesh Photography LTD',alt:'Un couple de mariés enlacé en extérieur'},
{id:'IAXH4tMEx_s',author:'Jen Vazquez',alt:'Une table de mariage décorée de fleurs et de bougies'},
{id:'3nj-jsGwjVg',author:'Bruno Ngarukiye',alt:'Une table de réception ornée de compositions florales'},
];
const assignments:Record<string,number>={
'wedding-planners-metz':1,'wedding-planners-marseille':2,'wedding-planners-cholet':1,'wedding-planners-reims':2,'wedding-planners-rochefort':1,'wedding-planners-caen':2,'wedding-planners-brest':1,'wedding-planners-valence':2,
'photographes-mariage-nantes':0,'photographes-mariage-la-rochelle':1,'photographes-mariage-nice':0,'photographes-mariage-grenoble':2,'photographes-mariage-chartres':0,'photographes-mariage-tours':1,'photographes-mariage-vannes':0,
};
const photo=photos[assignments[articleId]??0];
---
<figure class="comparison-visual"><div class="comparison-visual-frame"><img src={`https://unsplash.com/photos/${photo.id}/download?force=true&w=960`} alt={photo.alt} width="960" height="600" loading="eager" decoding="async" /></div><figcaption>Photo : {photo.author} / Unsplash.<span>Image d’illustration, sans lien avec les prestataires cités.</span></figcaption></figure>
<style>
.comparison-visual{width:100%;max-width:560px;margin:0 0 30px}.comparison-visual-frame{aspect-ratio:8/5;overflow:hidden;border:1px solid #d9cfc2;border-radius:4px;background:#E8DED0}.comparison-visual img{display:block;width:100%;height:100%;object-fit:cover;object-position:center}.comparison-visual figcaption{margin-top:9px;font-size:.75rem;line-height:1.6;color:#493D35}.comparison-visual figcaption span{display:block}@media(max-width:600px){.comparison-visual{max-width:100%;margin-bottom:24px}}
</style>
