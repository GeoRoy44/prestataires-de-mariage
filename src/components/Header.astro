---
const navItems = [
  { href: '/photographie-video/', label: 'Photo & vidéo' },
  { href: '/reception-restauration/', label: 'Lieux & traiteurs' },
  { href: '/ambiance-decoration/', label: 'Musique & décoration' },
  { href: '/organisation-accompagnement/', label: 'Organisation du mariage' },
  { href: '/blog/', label: 'Conseils & guides' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Prestataires de Mariage, accueil"><span class="brand-mark" aria-hidden="true">P</span><span>Prestataires<br />de Mariage</span></a>
    <nav aria-label="Navigation principale"><ul>{navItems.map((item) => <li><a href={item.href} aria-current={currentPath === item.href.replace(/\/+$/, '') ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
    <a class="header-cta" href="/plan-du-site/">Toutes les rubriques <span aria-hidden="true">↗</span></a>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:20;background:#f8f5ef;border-bottom:1px solid var(--line)}
.header-inner{min-height:88px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px 20px;padding-block:14px}
.brand{display:flex;align-items:center;gap:10px;font-family:'DM Serif Display',serif;font-size:1.12rem;line-height:1.1;color:#24231f;flex-shrink:0}
.brand-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--forest);color:var(--gold-soft);font-size:1.5rem}
.site-header nav{flex:1 1 620px;min-width:0}
.site-header ul{list-style:none;display:flex;justify-content:center;flex-wrap:wrap;gap:6px;padding:0;margin:0}
.site-header nav a{display:flex;align-items:center;justify-content:center;min-height:44px;padding:10px 12px;border-radius:8px;border:1px solid transparent;font-size:1rem;font-weight:700;line-height:1.4;color:#24231f;text-align:center;text-wrap:balance;text-decoration:none;transition:background-color .18s ease,color .18s ease}
.site-header nav a:hover{background:#eee2bd;color:#24231f}
.site-header nav a[aria-current="page"]{background:#30453c;color:#fff}
.site-header a:focus-visible{outline:3px solid #80651b;outline-offset:3px}
.header-cta{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 14px;border:1px solid #30453c;border-radius:8px;font-size:.9rem;font-weight:800;line-height:1.4;color:#30453c}
.header-cta:hover{background:#30453c;color:#fff}
@media(max-width:1150px){.site-header nav{order:3;flex-basis:100%}.site-header ul{justify-content:flex-start}.header-cta{margin-left:auto}}
@media(max-width:600px){.site-header{position:relative}.header-inner{gap:12px;padding-block:12px}.brand{font-size:1rem}.header-cta{font-size:.8rem;padding:8px 10px;max-width:48%}.site-header ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.site-header nav a{height:100%;padding:10px 8px;font-size:.95rem;background:#fffcf7;border-color:#ddd5c6}.site-header li:last-child{grid-column:1 / -1}}
@media(prefers-reduced-motion:reduce){.site-header nav a{transition:none}}
</style>
