---
const photos = [
  { id: 'f_OHqCqfLR4', author: 'Sabesh Photography LTD', alt: 'Un couple de mariés enlacé en extérieur', title: 'Des émotions à préserver' },
  { id: 'IAXH4tMEx_s', author: 'Jen Vazquez', alt: 'Une table de mariage décorée de fleurs et de bougies', title: 'Une réception à votre image' },
  { id: '3nj-jsGwjVg', author: 'Bruno Ngarukiye', alt: 'Une table de réception ornée de compositions florales', title: 'Le sens du détail' },
];
---
<section class="wedding-gallery section" aria-labelledby="gallery-title">
  <div class="container">
    <div class="gallery-heading"><p class="luxe-kicker">L’émotion en fil conducteur</p><h2 id="gallery-title">Imaginer votre journée.<br /><em>Donner vie à vos envies.</em></h2><p>Des instants partagés, une table accueillante, des détails qui vous ressemblent.</p></div>
    <div class="gallery-grid">{photos.map(photo => <figure><div class="gallery-image"><img src={`https://unsplash.com/photos/${photo.id}/download?force=true&w=960`} alt={photo.alt} width="960" height="1200" loading="lazy" decoding="async" referrerpolicy="strict-origin-when-cross-origin" /></div><figcaption><h3>{photo.title}</h3><a href={`https://unsplash.com/photos/${photo.id}`} target="_blank" rel="noopener noreferrer">Photo : {photo.author} / Unsplash<span class="sr-only"> (nouvel onglet)</span></a></figcaption></figure>)}</div>
    <p class="gallery-note">Photographies d’illustration : elles ne représentent pas une sélection de prestataires référencés sur ce site.</p>
  </div>
</section>
<style>
.wedding-gallery{background:#F8F5EF;border-bottom:1px solid #d9cfc2}.gallery-heading{max-width:700px;margin-bottom:36px}.gallery-heading>p:last-child{color:#493D35}.gallery-heading h2{font-weight:400;line-height:1.15}.gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.gallery-grid figure{margin:0;min-width:0}.gallery-image{aspect-ratio:4/5;overflow:hidden;border-radius:140px 140px 3px 3px;background:#E8DED0}.gallery-grid figure:nth-child(2) .gallery-image{border-radius:3px}.gallery-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .4s ease}.gallery-grid figure:hover img{transform:scale(1.025)}figcaption{padding-top:18px}figcaption h3{font-size:1.4rem;margin:0 0 8px}figcaption a{color:#493D35;font-size:.78rem;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.gallery-note{margin:28px 0 0;font-size:.78rem;color:#493D35}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}@media(max-width:700px){.gallery-grid{grid-template-columns:1fr;gap:32px}.gallery-image{aspect-ratio:5/4;border-radius:70px 70px 3px 3px}}@media(prefers-reduced-motion:reduce){.gallery-image img{transition:none}.gallery-grid figure:hover img{transform:none}}
</style>
