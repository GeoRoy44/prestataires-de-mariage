---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import LocalComparison from '../components/LocalComparison.astro';
const {article,related}=Astro.props as {article:CollectionEntry<'blog'>;related:CollectionEntry<'blog'>[]};
const labels:Record<string,string>={'photographie-video':'Photographie & vidéo','reception-restauration':'Réception & restauration','ambiance-decoration':'Ambiance & décoration','organisation-accompagnement':'Organisation & accompagnement'};
const comparisonIds=new Set(['wedding-planners-metz','wedding-planners-marseille','wedding-planners-cholet','wedding-planners-reims','wedding-planners-rochefort','wedding-planners-caen','wedding-planners-brest','wedding-planners-valence','photographes-mariage-nantes','photographes-mariage-la-rochelle','photographes-mariage-nice','photographes-mariage-grenoble','photographes-mariage-chartres','photographes-mariage-tours','photographes-mariage-vannes']);
const isComparison=comparisonIds.has(article.id);
---
<BaseLayout title={article.data.title} description={article.data.description}><Breadcrumbs items={[{label:'Guides',href:'/blog/'},{label:labels[article.data.category],href:`/${article.data.category}/`},{label:article.data.title}]}/><article class="article"><div class="container"><header class="article-header"><p class="eyebrow">{labels[article.data.category]}</p><h1>{article.data.title}</h1>{!isComparison&&<p class="lead">{article.data.description}</p>}<p class="article-date">Publié le {article.data.pubDate.toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'})}</p></header>{isComparison?<LocalComparison article={article}/>:<div class="prose"><slot/></div>}</div></article><RelatedArticles articles={related}/></BaseLayout>
<style>.article{padding:30px 0 72px}.article-header{max-width:880px;border-bottom:1px solid var(--line);padding-bottom:34px;margin-bottom:32px}.article-date{color:var(--muted);font-size:.8rem;margin:24px 0 0}</style>
