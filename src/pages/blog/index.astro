---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Guides pour choisir vos prestataires de mariage" description="Préparez vos rendez-vous, comparez les devis et vérifiez les prestations selon vos besoins."><Breadcrumbs items={[{label:'Guides'}]} /><section class="section"><div class="container"><p class="eyebrow">Préparer votre prochaine décision</p><h1>Quels points souhaitez-vous vérifier ?</h1><p class="lead">Vous préparez un rendez-vous ou comparez plusieurs devis. Choisissez un guide pour préciser vos besoins et noter les questions à poser.</p><div class="card-grid blog-grid">{articles.map(article=><ArticleCard article={article}/>)}</div></div></section></BaseLayout>
<style>.blog-grid{margin-top:38px}</style>
