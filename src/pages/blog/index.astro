---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Les guides au fil de vos préparatifs de mariage" description="Des éclairages sur les prestations, les devis et les rendez-vous, selon les questions de votre mariage."><Breadcrumbs items={[{label:'Guides'}]}/><section class="section"><div class="container"><p class="eyebrow">Une question ouvre la prochaine étape</p><h1>Des repères pour vos préparatifs.</h1><p class="lead">Un devis vient d’arriver, un rendez-vous approche ou une idée demande à mûrir. Chaque guide éclaire une question, sans ajouter de nouvelle obligation.</p><p>Les <a href="/photographie-video/">images de la journée</a>, le <a href="/reception-restauration/">repas et son service</a>, l’<a href="/ambiance-decoration/">aménagement du lieu</a> et le <a href="/organisation-accompagnement/">calendrier des préparatifs</a> offrent plusieurs portes d’entrée.</p><div class="card-grid blog-grid">{articles.map(article=><ArticleCard article={article} headingLevel={2}/>)}</div></div></section></BaseLayout>
<style>.blog-grid{margin-top:38px}</style>
