---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FloatingSymbols from '../components/FloatingSymbols.astro';
import WeddingGallery from '../components/WeddingGallery.astro';
import '../styles/luxury-home.css';
const articles = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pillars = [
  {href:'/photographie-video/',number:'01',title:'Photographie & vidéo',text:'Un regard singulier pour raconter votre journée et préserver ce qui compte.'},
  {href:'/reception-restauration/',number:'02',title:'Réception & restauration',text:'Des saveurs, un service et une réception pensés pour vos invités.'},
  {href:'/ambiance-decoration/',number:'03',title:'Ambiance & décoration',text:'La musique, les fleurs et les détails qui donnent une âme à votre réception.'},
  {href:'/organisation-accompagnement/',number:'04',title:'Organisation & accompagnement',text:'Des décisions éclairées, un budget structuré et une journée sereine.'},
];
---
<BaseLayout title="Choisir ses prestataires de mariage" description="Des guides concrets pour comparer, sélectionner et travailler sereinement avec les prestataires de votre mariage.">
  <div class="luxury-home">
    <section class="luxe-hero" aria-labelledby="hero-title">
      <div class="luxe-atmosphere" aria-hidden="true"><span class="luxe-halo luxe-halo--blue"></span><span class="luxe-halo luxe-halo--violet"></span><span class="luxe-halo luxe-halo--gold"></span><span class="luxe-orbit"></span><span class="luxe-stars"></span></div>
      <FloatingSymbols />
      <div class="container luxe-hero-grid">
        <div class="luxe-intro"><p class="luxe-kicker">Le guide des futurs mariés</p><h1 id="hero-title">Une journée unique.<br />Les <em>bonnes personnes.</em></h1><p class="luxe-lead">Derrière chaque beau mariage, des professionnels bien choisis. Nos guides vous aident à comprendre, comparer et décider avec confiance.</p><div class="luxe-actions"><a class="luxe-button" href="/blog/">Découvrir les guides <span aria-hidden="true">↗</span></a><a class="luxe-text-link" href="#univers">Explorer les univers <span aria-hidden="true">↓</span></a></div><p class="luxe-caption">Photographie · Réception · Ambiance · Organisation</p></div>
        <aside class="luxe-manifesto"><span class="luxe-seal" aria-hidden="true">P / M</span><p class="luxe-kicker">Le sens du détail</p><h2>Choisir avec exigence.<br /><em>Avancer sereinement.</em></h2><p>Pas un annuaire interminable. Des repères concrets pour poser les bonnes questions, lire les devis et trouver votre équilibre.</p><a class="luxe-text-link" href="/a-propos/">Notre approche <span aria-hidden="true">→</span></a></aside>
      </div>
      <div class="container luxe-hero-foot"><span>Comprendre avant de choisir</span><span>Votre mariage, vos priorités</span></div>
    </section>
    <WeddingGallery />
    <section id="univers" class="section luxe-univers"><div class="container"><div class="luxe-section-heading"><div><p class="luxe-kicker">Quatre univers, une même exigence</p><h2>Les talents qui font<br /><em>la différence.</em></h2></div><p>À chaque étape, les bons repères pour choisir une prestation qui vous ressemble.</p></div><div class="luxe-pillars">{pillars.map(pillar => <a class="luxe-pillar" href={pillar.href}><span class="luxe-number">{pillar.number}</span><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="luxe-pillar-link">Explorer <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
    <section class="section luxe-guides"><div class="container"><div class="luxe-section-heading"><div><p class="luxe-kicker">Le carnet de conseils</p><h2>Des choix éclairés.<br /><em>Des préparatifs apaisés.</em></h2></div><a class="luxe-text-link" href="/blog/">Tous les guides <span aria-hidden="true">→</span></a></div><div class="card-grid">{articles.slice(0,3).map(article => <ArticleCard article={article} />)}</div></div></section>
    <section class="luxe-closing"><div class="container"><p class="luxe-kicker">L’essentiel, simplement</p><h2>Votre histoire mérite<br /><em>les bons partenaires.</em></h2><a class="luxe-button" href="/plan-du-site/">Préparer mes choix <span aria-hidden="true">↗</span></a></div></section>
  </div>
</BaseLayout>
