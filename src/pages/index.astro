---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import WeddingHero from '../components/WeddingHero.astro';
import WeddingGallery from '../components/WeddingGallery.astro';
import WeddingFAQ from '../components/WeddingFAQ.astro';
import '../styles/luxury-home.css';
const articles=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const pillars=[
{href:'/photographie-video/',number:'01',title:'Photographie & vidéo',text:'Un regard sur vos proches, un geste, une lumière. Le style du reportage et les moments couverts dessinent les premiers critères de choix.'},
{href:'/reception-restauration/',number:'02',title:'Réception & restauration',text:'Autour des tables, le repas accompagne les retrouvailles. Le nombre d’invités, le service et les possibilités du lieu donnent un cadre aux envies.'},
{href:'/ambiance-decoration/',number:'03',title:'Ambiance & décoration',text:'Quelques fleurs, une matière, une musique familière. L’espace disponible et les conditions d’installation aident à trouver la juste place de chaque détail.'},
{href:'/organisation-accompagnement/',number:'04',title:'Organisation & accompagnement',text:'Un calendrier partagé peut devenir le fil des préparatifs. Les priorités, le budget et les tâches à répartir éclairent l’accompagnement souhaité.'},
];
---
<BaseLayout title="Vos prestataires de mariage, au fil de vos envies" description="Des repères pour comprendre les prestations et trouver les professionnels qui correspondent à votre réception, votre budget et vos envies.">
<div class="luxury-home"><WeddingHero />
<section class="section"><div class="container editorial-blocks"><article><p class="luxe-kicker">Les personnes derrière les préparatifs</p><h2>Une journée se dessine.<br /><em>Des liens lui donnent vie.</em></h2><p>La liste des invités prend forme, les premiers lieux se visitent et quelques images rejoignent votre carnet d’idées. Derrière chaque envie se pose la question des personnes qui pourront lui donner une forme concrète.</p><p>Un photographe attentif aux échanges, un traiteur à l’écoute des convives ou une coordination discrète peuvent trouver leur place dans votre projet. Nos guides vous accompagnent dans ces rencontres, avec des repères sur les prestations, les échanges et les conditions proposées.</p><a class="luxe-text-link" href="/a-propos/">Notre manière de vous accompagner <span aria-hidden="true">→</span></a></article><article><p class="luxe-kicker">Un équilibre qui vous appartient</p><h2>Quelques choix essentiels.<br /><em>Une réception à votre mesure.</em></h2><p>Une grande table ou plusieurs petits espaces, un dîner servi ou un buffet : votre réception peut prendre des chemins différents. Le lieu, le nombre de proches et le budget dessinent un cadre, sans raconter toute l’histoire.</p><p>À l’intérieur de ce cadre, certains détails comptent davantage pour vous, tandis que d’autres peuvent rester simples. La comparaison des devis et des possibilités d’installation aide alors à relier vos envies aux réalités de la journée.</p><a class="luxe-text-link" href="/organisation-accompagnement/">Les repères pour votre organisation <span aria-hidden="true">→</span></a></article></div></section>
<WeddingGallery />
<section id="univers" class="section luxe-univers"><div class="container"><div class="luxe-section-heading"><div><p class="luxe-kicker">Quatre portes d’entrée dans les préparatifs</p><h2>Des envies prennent forme.<br /><em>Des repères les accompagnent.</em></h2></div><p>De la photographie au repas, chaque rubrique relie vos questions aux critères utiles pour votre réception.</p></div><div class="luxe-pillars">{pillars.map(pillar=><a class="luxe-pillar" href={pillar.href}><span class="luxe-number">{pillar.number}</span><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="luxe-pillar-link">Les repères de cette rubrique <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
<section class="section luxe-guides"><div class="container"><div class="luxe-section-heading"><div><p class="luxe-kicker">Au fil de vos questions</p><h2>Un peu de clarté.<br /><em>Pour la suite des préparatifs.</em></h2></div><a class="luxe-text-link" href="/blog/">Tous les guides <span aria-hidden="true">→</span></a></div><div class="card-grid">{articles.slice(0,3).map(article=><ArticleCard article={article}/>)}</div></div></section>
<section class="luxe-closing"><div class="container"><p class="luxe-kicker">À votre rythme</p><h2>La prochaine étape<br /><em>commence avec vos envies.</em></h2><a class="luxe-button" href="/plan-du-site/">Les guides pour la suite <span aria-hidden="true">↗</span></a></div></section><WeddingFAQ /></div>
</BaseLayout>
<style>.editorial-blocks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:64px}.editorial-blocks article{min-width:0}.editorial-blocks h2{font-size:clamp(2rem,3.4vw,3.2rem)}.editorial-blocks article>p:not(.luxe-kicker){color:#493D35;font-size:1rem;line-height:1.85}.editorial-blocks .luxe-text-link{margin-top:8px}@media(max-width:800px){.editorial-blocks{grid-template-columns:1fr;gap:40px}}</style>
