---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
const articles = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const pillars = [
  {href:'/photographie-video/',title:'Photographie & vidéo',text:'Choisir un regard, un style de reportage et une prestation qui vous ressemble.'},
  {href:'/reception-restauration/',title:'Réception & restauration',text:'Composer un repas fluide, gourmand et adapté à vos invités comme à votre budget.'},
  {href:'/ambiance-decoration/',title:'Ambiance & décoration',text:'Créer une atmosphère cohérente avec la musique, les fleurs, le mobilier et les détails.'},
  {href:'/organisation-accompagnement/',title:'Organisation & accompagnement',text:'Structurer les décisions, les contrats, les devis et le déroulé de votre journée.'},
];
---
<BaseLayout title="Choisir ses prestataires de mariage" description="Des guides concrets pour comparer, sélectionner et travailler sereinement avec les prestataires de votre mariage."><section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Le guide des futurs mariés</p><h1>Choisir les bonnes personnes pour une journée qui vous ressemble.</h1><p class="lead">Photographe, traiteur, DJ, fleuriste ou wedding planner : des repères concrets pour comparer les prestations, poser les bonnes questions et avancer avec confiance.</p><div class="button-row"><a class="button" href="/blog/">Lire les guides</a><a class="button button--ghost" href="/plan-du-site/">Explorer les sujets</a></div></div><aside class="hero-note"><p class="eyebrow">Notre promesse</p><h2>Des conseils utiles, pas un annuaire vide.</h2><p>Chaque guide vous aide à comprendre une prestation, évaluer un devis et préparer les échanges décisifs avec les professionnels.</p></aside></div></section><section class="section"><div class="container"><p class="eyebrow">Par besoin</p><h2>Préparer votre recherche, étape par étape.</h2><div class="card-grid pillars">{pillars.map((pillar) => <a class="pillar" href={pillar.href}><span>→</span><h3>{pillar.title}</h3><p>{pillar.text}</p></a>)}</div></div></section><section class="section section--soft"><div class="container"><p class="eyebrow">Guides récents</p><h2>Pour décider sans laisser les détails au hasard.</h2><div class="card-grid">{articles.slice(0,3).map((article) => <ArticleCard article={article} />)}</div></div></section><NewsletterCTA /></BaseLayout>
<style>.hero{padding:92px 0 78px;background:radial-gradient(circle at 88% 15%,var(--gold-soft),transparent 28%),var(--surface);border-bottom:1px solid var(--line)}.hero-grid{display:grid;grid-template-columns:1.4fr .7fr;gap:50px;align-items:end}.hero-note{padding:28px;background:var(--forest);color:#fff;border-radius:20px}.hero-note h2{font-size:2rem}.hero-note p:last-child{color:#d9e2dc}.pillars{grid-template-columns:repeat(4,1fr)}.pillar{border-top:3px solid var(--gold);padding:18px 0}.pillar span{color:var(--gold-dark);font-size:1.4rem}.pillar p{color:var(--muted);font-size:.9rem}@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.pillars{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hero{padding:62px 0}.pillars{grid-template-columns:1fr}}</style>
