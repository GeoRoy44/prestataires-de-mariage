---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const articles=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title,'fr'));
const categories=[['photographie-video','Photographie & vidéo'],['reception-restauration','Réception & restauration'],['ambiance-decoration','Ambiance & décoration'],['organisation-accompagnement','Organisation & accompagnement']] as const;
const pages=[['Accueil','/'],['Photographie & vidéo','/photographie-video/'],['Réception & restauration','/reception-restauration/'],['Ambiance & décoration','/ambiance-decoration/'],['Organisation & accompagnement','/organisation-accompagnement/'],['Guides pratiques','/blog/'],['À propos','/a-propos/'],['Mentions légales','/mentions-legales/'],['Politique de confidentialité','/politique-confidentialite/']];
---
<BaseLayout title="Plan du site" description="Retrouvez les rubriques et les guides pour préparer vos choix de prestataires."><Breadcrumbs items={[{label:'Plan du site'}]} /><section class="section"><div class="container prose"><p class="eyebrow">Retrouver une rubrique</p><h1>Plan du site</h1><p>Vous cherchez un guide sur le repas, les photos ou le budget. Retrouvez les pages ci-dessous, puis choisissez votre sujet.</p><h2>Les pages du site</h2><ul>{pages.map(([label,href])=><li><a href={href}>{label}</a></li>)}</ul>{categories.map(([key,label])=>{const entries=articles.filter(article=>article.data.category===key);return <><h2>{label}</h2>{entries.length ? <ul>{entries.map(article=><li><a href={`/blog/${article.id}/`}>{article.data.title}</a></li>)}</ul> : <p>Aucun guide n’est encore publié dans cette rubrique.</p>}</>})}<p>Vous hésitez entre plusieurs sujets ? Commencez par la décision que vous devez préparer maintenant.</p></div></section></BaseLayout>
