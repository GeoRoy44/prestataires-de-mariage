---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const articles=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>a.data.title.localeCompare(b.data.title,'fr'));
const categories=[['photographie-video','Photographie & vidéo'],['reception-restauration','Réception & restauration'],['ambiance-decoration','Ambiance & décoration'],['organisation-accompagnement','Organisation & accompagnement']] as const;
const pages=[['Accueil','/'],['Photographie & vidéo','/photographie-video/'],['Réception & restauration','/reception-restauration/'],['Ambiance & décoration','/ambiance-decoration/'],['Organisation & accompagnement','/organisation-accompagnement/'],['Guides pratiques','/blog/'],['À propos','/a-propos/'],['Mentions légales','/mentions-legales/'],['Politique de confidentialité','/politique-confidentialite/']];
---
<BaseLayout title="Plan du site : les rubriques et les guides" description="Les pages et les articles réunis par thème pour accompagner vos recherches de prestataires."><Breadcrumbs items={[{label:'Plan du site'}]}/><section class="section"><div class="container prose"><p class="eyebrow">Les chemins de votre recherche</p><h1>Plan du site</h1><p>Une question sur le repas mène parfois à une réflexion sur le budget. Les pages sont réunies ici pour vous laisser passer d’un sujet à l’autre.</p><h2>Les pages principales</h2><ul>{pages.map(([label,href])=><li><a href={href}>{label}</a></li>)}</ul>{categories.map(([key,label])=>{const entries=articles.filter(article=>article.data.category===key);return <><h2>{label}</h2>{entries.length?<ul>{entries.map(article=><li><a href={`/blog/${article.id}/`}>{article.data.title}</a></li>)}</ul>:<p>Cette rubrique ne contient pas encore de guide.</p>}</>})}<p>Chaque rubrique peut se lire à votre rythme, selon la décision qui se dessine.</p></div></section></BaseLayout>
